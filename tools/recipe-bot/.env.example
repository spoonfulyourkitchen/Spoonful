# Spoonful Recipe-Bot — Secrets (NICHT committen; steht in .gitignore)
# Nach dem Rotieren der Keys hier die neuen Werte eintragen.
SUPABASE_URL=https://gmfkleugoxafmvprqatk.supabase.co
SUPABASE_SERVICE_ROLE_KEY=HIER-DEN-NEUEN-SERVICE-ROLE-KEY-EINTRAGEN

# OpenRouter: mehrere Keys = mehrere Gratis-Kontingente.
# Der Bot rotiert sie automatisch und testet Modelle parallel.
OPENROUTER_API_KEY=HIER-DEN-ERSTEN-KEY-EINTRAGEN
OPENROUTER_API_KEY_2=sk-or-v1-...
OPENROUTER_API_KEY_3=sk-or-v1-...
# alternativ alle in einer Zeile, Komma-getrennt:
# OPENROUTER_API_KEYS=sk-or-v1-aaa,sk-or-v1-bbb,sk-or-v1-ccc

OPENROUTER_MODEL=openai/gpt-4o-mini
