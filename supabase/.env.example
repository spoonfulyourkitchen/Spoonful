# Supabase-Zugang (lokal, NICHT ins Git committen!)
# Kopiere diese Datei nach ".env.local" und fülle sie aus.
# Wo finden: Supabase Dashboard → Project Settings → API

SUPABASE_URL=https://XXXX.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # nur für Migration/Admin, geheim halten!

# Direkte Datenbank-Verbindung (damit ich Schema + Import selbst ausführen kann)
# Supabase Dashboard → Project Settings → Database → Connection string (URI)
# Dort [YOUR-PASSWORD] durch dein Datenbank-Passwort ersetzen
# (Passwort vergessen? → "Reset database password")
DATABASE_URL=postgresql://postgres.XXXX:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres

